<?xml version="1.0" encoding="utf-8"?>
<!-- [Jalur Class/Modul]: filemanager-ui/src/main/AndroidManifest.xml -->
<!-- [Penjelasan]: Mendaftarkan package visibility queries pada intent ACTION_VIEW untuk mendeteksi aplikasi pihak ketiga yang kompatibel membuka berkas. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
